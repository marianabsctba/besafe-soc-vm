# Tela de login Be Safe
[greeter]
background = {{ branding_dir }}/login.png
user-background = false
theme-name = Adwaita-dark
icon-theme-name = Papirus-Dark
font-name = Rajdhani Medium 13
default-user-image = {{ branding_dir }}/icone-256.png
indicators = ~host;~spacer;~clock;~spacer;~power
clock-format = %d/%m  %H:%M
position = 50%,center 72%,center
panel-position = bottom
