#!/bin/bash
# Gera uma senha nova para o admin do Wazuh e grava as credenciais do aluno.
#
# Usado pelo primeiro boot e tambem como resgate, a qualquer momento:
#     sudo besafe-senha-wazuh
#
# So depende do indexer (a troca usa os certificados de admin), entao funciona
# mesmo que a API do Wazuh ainda esteja subindo.
set -uo pipefail

FERRAMENTA=/usr/share/wazuh-indexer/plugins/opensearch-security/tools/wazuh-passwords-tool.sh
USUARIO="${BESAFE_USUARIO:-analista}"

[ "$(id -u)" = 0 ] || { echo "Rode com sudo: sudo besafe-senha-wazuh"; exit 1; }

# aleatorio de um conjunto de caracteres (tr | head gera "Broken pipe" inofensivo)
aleatorio() { tr -dc "$1" </dev/urandom 2>/dev/null | head -c "$2"; }
# politica da ferramenta: 8 a 64 caracteres, maiuscula, minuscula, numero e um de .*+?-
gerar_senha() { echo "$(aleatorio 'A-HJ-NP-Z' 4)$(aleatorio 'a-km-z' 6).$(aleatorio '2-9' 4)-$(aleatorio 'A-HJ-NP-Za-km-z2-9' 4)"; }

esperar_indexer() {
  local i
  for i in $(seq 1 180); do  # ate 15 minutos
    curl -sk -o /dev/null --max-time 5 https://127.0.0.1:9200 && return 0
    sleep 5
  done
  return 1
}

gravar_credenciais() {  # $1 = senha do admin
  local destino="/home/$USUARIO/.besafe" mesa="/home/$USUARIO/Desktop"
  install -d -m 700 -o "$USUARIO" -g "$USUARIO" "$destino"
  printf 'Wazuh dashboard: https://localhost\nusuario: admin\nsenha: %s\n' "$1" > "$destino/wazuh.txt"
  chown "$USUARIO:$USUARIO" "$destino/wazuh.txt"
  chmod 600 "$destino/wazuh.txt"

  # credenciais visiveis na area de trabalho (a VM e de laboratorio e so escuta em localhost)
  install -d -m 755 -o "$USUARIO" -g "$USUARIO" "$mesa"
  cat > "$mesa/CREDENCIAIS.txt" <<CRED
BE SAFE SOC LAB - credenciais desta VM

Login da VM e sudo
  usuario: analista
  senha:   analista

Wazuh dashboard (abra no Firefox: https://localhost)
  usuario: admin
  senha:   $1

A senha do Wazuh e unica desta copia da VM (gerada no primeiro boot).
Ela tambem fica em ~/.besafe/wazuh.txt e aparece ao abrir o terminal.
Perdeu a senha? No terminal: sudo besafe-senha-wazuh

Powered By Mariana BS
CRED
  chown "$USUARIO:$USUARIO" "$mesa/CREDENCIAIS.txt"
  chmod 600 "$mesa/CREDENCIAIS.txt"
}

# so roda o resto quando executado diretamente (o primeiro boot usa as funcoes)
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  echo "Esperando o Wazuh indexer..."
  esperar_indexer || { echo "O Wazuh indexer nao respondeu. Espere alguns minutos e rode de novo."; exit 1; }
  senha=$(gerar_senha)
  for tentativa in 1 2 3; do
    echo "Trocando a senha do admin (tentativa $tentativa)..."
    if bash "$FERRAMENTA" -u admin -p "$senha" >/dev/null 2>&1; then
      gravar_credenciais "$senha"
      echo
      echo "Pronto. Wazuh: usuario admin | senha $senha"
      echo "Tambem gravada em ~/.besafe/wazuh.txt e no CREDENCIAIS.txt da area de trabalho."
      exit 0
    fi
    sleep 30
    esperar_indexer || true
  done
  echo "Nao consegui trocar a senha. Reinicie a VM, espere 5 minutos e rode de novo."
  exit 1
fi
